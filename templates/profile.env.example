# Copy the values you need into <PROFILE_HOME>/.env

# LanceDB Pro memory provider
LANCEDB_PRO_HERMES_DB_PATH=/absolute/path/to/lancedb
LANCEDB_PRO_HERMES_TABLE_NAME=memories
LANCEDB_PRO_HERMES_NODE_BIN=/opt/homebrew/bin/node
LANCEDB_PRO_HERMES_LANCEDB_MODULE=/absolute/path/to/lancedb-pro-hermes/node_modules/@lancedb/lancedb/dist/index.js
LANCEDB_PRO_HERMES_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
LANCEDB_PRO_HERMES_EMBEDDING_MODEL=mxbai-embed-large:latest
LANCEDB_PRO_HERMES_EMBEDDING_API_KEY=ollama-local
LANCEDB_PRO_HERMES_GLOBAL_SCOPE=global
LANCEDB_PRO_HERMES_SCOPE_MAP={"coder":"agent:coder"}
LANCEDB_PRO_HERMES_DECAY_HALF_LIFE_DAYS=180

# Platform secrets belong here too, but do not commit them.
# TELEGRAM_BOT_TOKEN=
# LINE_CHANNEL_ACCESS_TOKEN=
# SLACK_BOT_TOKEN=

