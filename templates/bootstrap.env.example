HERMES_BIN="$HOME/.hermes/hermes-agent/venv/bin/hermes"
HERMES_ROOT="$HOME/.hermes"
PROFILE_NAME="coder"
PROFILE_HOME="$HERMES_ROOT/profiles/$PROFILE_NAME"

REPOS_DIR="$HOME/src/hermes-bootstrap"

NOTEBOOKLM_HERMES_SKILL_REPO="https://github.com/sscomp/notebooklm-hermes-skill.git"
NOTEBOOKLM_PY_REPO="https://github.com/sscomp/notebooklm-py.git"
LANCEDB_PRO_HERMES_PLUGIN_REPO="https://github.com/sscomp/lancedb-pro-hermes-plugin.git"
CODEX_DISPATCH_HERMES_PLUGIN_REPO="https://github.com/sscomp/codex-dispatch-hermes-plugin.git"

NOTEBOOKLM_HERMES_SKILL_DIR="$REPOS_DIR/notebooklm-hermes-skill"
NOTEBOOKLM_PY_DIR="$REPOS_DIR/notebooklm-py"
LANCEDB_PRO_HERMES_PLUGIN_DIR="$REPOS_DIR/lancedb-pro-hermes-plugin"
CODEX_DISPATCH_HERMES_PLUGIN_DIR="$REPOS_DIR/codex-dispatch-hermes-plugin"

LANCEDB_DB_PATH="$HOME/hermes-data/lancedb"
LANCEDB_SCOPE_NAME="agent:coder"
LANCEDB_NODE_BIN="/opt/homebrew/bin/node"
MEMORY_MIGRATION_MODE="plan"
MEMORY_SOURCE_EXPORT=""
MEMORY_SOURCE_MAIN_EXPORT="$HOME/.hermes/migration/openclaw-lancedb-pro-export/agent-main.json"
MEMORY_SOURCE_N2_EXPORT="$HOME/.hermes/migration/openclaw-lancedb-pro-export/agent-n2.json"
MEMORY_SOURCE_SCOPE="agent:main"
MEMORY_TARGET_SCOPE="$LANCEDB_SCOPE_NAME"
MIGRATION_REPORT_DIR="$PROFILE_HOME/migration-reports"
MEMORY_REVIEW_DIR="$PROFILE_HOME/migration-review"
MEMORY_REVIEW_DECISIONS_FILE="$MEMORY_REVIEW_DIR/review-decisions.json"
MEMORY_ALLOW_N2_REMAP="0"

CODEX_ALLOWED_ROOT="$HOME"
CODEX_PATH="codex"
